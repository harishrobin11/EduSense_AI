# Environment Configuration
APP_NAME=EduSense AI
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=edusense_dev_secret_key_change_in_production_32bytes

# Backend Settings
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Default to SQLite for quick local development; set PostgreSQL connection string for production
DATABASE_URL=sqlite:///./edusense.db

# LLM Configuration (Ollama local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
